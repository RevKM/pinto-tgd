# Every text file uses LF line endings, on every system (WoW and the tests don't need CRLF).
* text=auto eol=lf
# except Windows scripts, which Windows runs with CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Textures and pictures are binary.
*.tga binary
*.png binary
*.jpg binary
*.blp binary
*.zip binary
